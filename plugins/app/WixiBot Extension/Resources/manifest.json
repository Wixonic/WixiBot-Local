{
	"manifest_version": 3,
	"name": "Safari RPC",
	"description": "Safari Extension for WixiBot",
	"version": "0.11.0",
	"icons": {
		"48": "images/icon-48.png",
		"96": "images/icon-96.png",
		"128": "images/icon-128.png",
		"256": "images/icon-256.png",
		"512": "images/icon-512.png"
	},
	"background": {
		"scripts": [
			"background.js"
		]
	},
	"content_scripts": [
		{
			"js": [
				"handlers/youtube.js"
			],
			"matches": [
				"https://www.youtube.com/watch*"
			]
		},
		{
			"js": [
				"handlers/github.js"
			],
			"matches": [
				"https://github.com/*",
				"https://github.com/*/*"
			]
		}
	],
	"action": {
		"default_icon": "images/toolbar-icon.svg"
	},
	"permissions": [
		"activeTab",
		"http://localhost:1000/",
		"background",
		"scripting"
	]
}