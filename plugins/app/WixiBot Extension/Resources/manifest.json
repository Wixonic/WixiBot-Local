{
	"manifest_version": 3,
	"name": "SafariRPC",
	"description": "Safari Extension for WixiBot",
	"version": "1.0.0",
	"icons": {
		"48": "images/icon-48.png",
		"96": "images/icon-96.png",
		"128": "images/icon-128.png",
		"256": "images/icon-256.png",
		"512": "images/icon-512.png"
	},
	"background": {
		"scripts": [
			"background.js",
			"secrets.js"
		]
	},
	"content_scripts": [
		{
			"js": [
				"content.js"
			],
			"matches": [
				"<all_urls>"
			]
		}
	],
	"action": {
		"default_icon": "images/toolbar-icon.svg"
	},
	"permissions": [
		"activeTab",
		"https://server.wixonic.fr",
		"background"
	]
}